{
  "version": 6,
  "configurePresets": [
    {
      "name": "native",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/debug/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "arm64-android-dynamic",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/debug/arm64-android-dynamic",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/toolchains/android.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android-dynamic",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-37"
      },
      "environment": {
        "ANDROID_NDK_HOME": "$penv{ANDROID_HOME}/ndk/30.0.16248370"
      }
    }
  ]
}
